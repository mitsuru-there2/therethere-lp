{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "therethere-studio",
  "account_id": "ebbbf8397629cebbce2ed54fb9f268ca",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-03",
  "routes": [
    {
      "pattern": "therethere.studio",
      "custom_domain": true
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "therethere-studio-cms"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "therethere-studio-media"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "CONTACT_ENABLED": "true"
  }
}
