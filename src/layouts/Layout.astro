---
import '@fontsource-variable/noto-sans-jp';
import '@fontsource-variable/bricolage-grotesque';
import '../styles/global.css';
import '../styles/neoflux.css';
import '../styles/typography.css';
import '../styles/studio.css';
import Arrow from '../components/Arrow.astro';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  clinic?: boolean;
  canonicalPath?: string;
}
const {
  title = 'There There Studio｜暮らしのそばに、使いたくなるアプリを。',
  description = '茨城県つくば市のアプリ開発スタジオ。WebとiOSのアプリ開発から、AIアプリ診療所での診断・運用支援まで。',
  noindex = false,
  clinic: isClinic = false,
  canonicalPath,
} = Astro.props;
const home = isClinic ? '/app-clinic' : '/';
const nav = isClinic ? [['/app-clinic#diagnosis', '診断内容'], ['/app-clinic#pricing', '料金'], ['/app-clinic/blog', 'ブログ'], ['/app-clinic#faq', 'よくある質問']] : [['/#works', 'Works'], ['/app-clinic', 'AIアプリ診療所'], ['/blog', 'ブログ'], ['/about', '運営について']];
const canonical = new URL(canonicalPath || Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(isClinic ? '/brand/logo-banner-neoflux.png' : '/images/studio-og.svg', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#D04060" />
    <link rel="icon" type="image/png" href="/brand/symbol-neoflux.png" />
    <link rel="apple-touch-icon" href="/brand/symbol-neoflux.png" />
  </head>
  <body class:list={{ "clinic-page": isClinic }}>
    <a class="skip-link" href="#main">
      本文へスキップ
    </a>
    <div class="announcement"><span>暮らしのそばに、使いたくなるアプリを。</span><a href={isClinic ? '/' : '/app-clinic'}>{isClinic ? 'There There Studio のアプリを見る' : 'AIでつくったアプリの運用相談はこちら'} ↗</a></div>
    <header class="site-header">
      <a class:list={['brand', { 'studio-brand': !isClinic }]} href={home} aria-label={isClinic ? 'AIアプリ診療所 ホーム' : 'There There Studio ホーム'}>
        {isClinic ? <img src="/brand/symbol-neoflux.png" width="45" height="45" alt="" /> : <span class="studio-mark" aria-hidden="true">tt.</span>}
        <span>{isClinic ? 'AIアプリ診療所' : 'There There'}<small>{isClinic ? 'BY THERE THERE STUDIO' : 'STUDIO / つくばのアプリ開発スタジオ'}</small></span>
      </a>
      <nav class="desktop-nav" aria-label="メインメニュー">{nav.map(([href,label]) => <a href={href}>{label}</a>)}</nav>
      <a class="header-cta" href={`${home}#contact`}>{isClinic ? '診断のご相談' : 'お問い合わせ'}<Arrow /></a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label="メニューを開く"><span></span><span></span></button>
      <nav id="mobile-nav" class="mobile-nav" hidden aria-label="モバイルメニュー">{nav.map(([href,label]) => <a href={href}>{label}</a>)}<a href={`${home}#contact`}>お問い合わせ ↗</a>{isClinic && <a href="/about">運営について</a>}</nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-top">
        <a class="brand studio-brand" href="/"><span class="studio-mark" aria-hidden="true">tt.</span><span>There There<small>STUDIO / 暮らしのそばに、使いたくなるアプリを。</small></span></a>
        <div class="footer-links">
          <a href="/#works">Works</a><a href="/blog">ブログ</a><a href="/about">運営について</a><a href="/about#legal">特定商取引法に基づく表記（準備中）</a><a href="/#contact">お問い合わせ</a><a href="/site-privacy">サイトのプライバシーポリシー</a><a href="/recorder/privacy">レコーダー維新のプライバシー</a><a href="/checklist/privacy">チェックリスト維新のプライバシー</a><a href="/app-clinic/terms">診療所のサービス提供条件</a>
        </div>
      </div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} There There Studio</span><span>つくばから、WebとiOSのアプリを。</span><a href="#main">ページの先頭へ ↑</a></div>
    </footer>
    <script>
      const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const mobileNav = document.querySelector<HTMLElement>('#mobile-nav');
      const close = () => {
        menu?.setAttribute('aria-expanded', 'false');
        menu?.setAttribute('aria-label', 'メニューを開く');
        if (mobileNav) mobileNav.hidden = true;
      };
      menu?.addEventListener('click', () => {
        const open = menu.getAttribute('aria-expanded') !== 'true';
        menu.setAttribute('aria-expanded', String(open));
        menu.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
        if (mobileNav) mobileNav.hidden = !open;
      });
      mobileNav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menu?.getAttribute('aria-expanded') === 'true') {
          close();
          menu.focus();
        }
      });
      if (
        !matchMedia('(prefers-reduced-motion: reduce)').matches &&
        'IntersectionObserver' in window
      ) {
        const observer = new IntersectionObserver(
          (entries) =>
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }),
          { threshold: 0.08 },
        );
        document.querySelectorAll('.reveal').forEach((el) => {
          el.classList.add('will-reveal');
          observer.observe(el);
        });
      }
      const emit = (event: string) =>
        window.dispatchEvent(
          new CustomEvent('clinic:analytics', { detail: { event, path: location.pathname } }),
        );
      document
        .querySelectorAll<HTMLElement>('[data-event]')
        .forEach((el) => el.addEventListener('click', () => emit(el.dataset.event!)));
      if ('IntersectionObserver' in window) {
        const views = new IntersectionObserver(
          (entries) =>
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                emit(`${entry.target.id}_view`);
                views.unobserve(entry.target);
              }
            }),
          { threshold: 0.3 },
        );
        document.querySelectorAll('#pricing, #report').forEach((el) => views.observe(el));
      }
    </script>
  </body>
</html>
