---
import { inquiryOptions } from '../../worker/inquiries';
import { ja } from '../data/ja';
import { renderParts } from '../lib/render';
import Arrow from './ProductArrow.astro';

const contact = ja.contact;
---
<section id="contact" class="contact-section" aria-labelledby="contact-title">
  <div class="section wrap contact-grid">
  <div class="contact-copy">
    <p class="section-label">Contact</p>
    <h2 id="contact-title" class="section-heading">アプリのこと、<br />話しませんか。</h2>
    <p class="hero-description" set:html={renderParts(contact.intro)} />
    <a class="email-link" href="mailto:info@therethere.studio">info@therethere.studio <Arrow diagonal /></a>
  </div>
  <form id="contact-form" class="contact-form" action="/api/contact" method="post" data-sending={contact.sending} data-submit={contact.submit} data-success={contact.success} data-error={contact.error}>
    <input type="hidden" name="locale" value="ja" />
    <div class="form-row">
      <label for="name">{contact.name} <span>{contact.required}</span></label>
      <input id="name" name="name" autocomplete="name" required maxlength="100" />
    </div>
    <div class="form-row">
      <label for="email">{contact.email} <span>{contact.required}</span></label>
      <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" />
    </div>
    <div class="form-row">
      <label for="company">{contact.company} <span>{contact.optional}</span></label>
      <input id="company" name="company" autocomplete="organization" maxlength="150" />
    </div>
    <div class="form-row">
      <label for="inquiry">{contact.inquiry} <span>{contact.required}</span></label>
      <select id="inquiry" name="inquiry" required>
        <option value="" disabled selected>{contact.placeholder}</option>
        {inquiryOptions.map((option) => <option value={option.value}>{option.ja}</option>)}
      </select>
    </div>
    <div class="form-row">
      <label for="message">{contact.message} <span>{contact.required}</span></label>
      <textarea id="message" name="message" rows="5" required maxlength="5000"></textarea>
    </div>
    <div class="honeypot" aria-hidden="true">
      <label for="website">{contact.honeypot}</label>
      <input id="website" name="website" tabindex="-1" autocomplete="off" />
    </div>
    <label class="consent"><input type="checkbox" name="consent" value="yes" required /><span set:html={renderParts(contact.consent)} /></label>
    <button class="button" type="submit"><span>{contact.submit}</span><Arrow /></button>
    <p id="form-status" class="form-status" role="status" aria-live="polite" tabindex="-1"></p>
    <noscript><p class="small-copy">{contact.noscript}</p></noscript>
  </form>
  </div>
</section>
<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLParagraphElement>('#form-status');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status || !button || button.disabled) return;
    const label = button.querySelector('span');
    if (!label) return;
    const sending = form.dataset.sending ?? '';
    const submitLabel = form.dataset.submit ?? '';
    button.disabled = true;
    label.textContent = sending;
    status.textContent = '';
    status.dataset.state = '';
    try {
      const response = await fetch(form.action, {
        method: 'POST', body: new URLSearchParams(new FormData(form) as unknown as Record<string, string>),
        headers: { Accept: 'application/json' }, signal: AbortSignal.timeout(15000),
      });
      const result = await response.json() as { ok?: boolean; message?: string };
      if (!response.ok || !result.ok) throw new Error(result.message || form.dataset.error);
      status.textContent = form.dataset.success ?? '';
      status.dataset.state = 'success';
      form.reset();
    } catch (error) {
      status.textContent = error instanceof Error && error.name !== 'TimeoutError' && error.name !== 'TypeError' && error.message
        ? error.message : (form.dataset.error ?? '');
      status.dataset.state = 'error';
    } finally {
      button.disabled = false;
      label.textContent = submitLabel;
      status.focus();
    }
  });
</script>
