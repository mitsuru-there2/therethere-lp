---
import Arrow from "./Arrow.astro";

const technologies = [
  { name: "React", file: "react.svg", slug: "react" },
  { name: "TypeScript", file: "typescript.svg", slug: "typescript" },
  { name: "Next.js", file: "nextjs.svg", slug: "nextjs" },
  { name: "Vercel", file: "vercel.svg", slug: "vercel" },
  { name: "WordPress", file: "wordpress.png", slug: "wordpress" },
  { name: "Cloudflare", file: "cloudflare.svg", slug: "cloudflare" },
  { name: "PHP", file: "php.svg", slug: "php" },
  { name: "EmDash", file: "emdash.svg", slug: "emdash" },
];
---

<section class="stack-hero" aria-labelledby="studio-title">
  <div class="stack-stage">
    <div class="stack-copy">
      <p class="stack-eyebrow">APP DEVELOPMENT STUDIO</p>
      <img
        class="stack-wordmark"
        src="/brand/therethere-studio-banner-blue-v1.png"
        width="1983"
        height="793"
        alt="There There Studio."
        fetchpriority="high"
      />
      <h1 id="studio-title">
        小さなアイデアを、
        <br />
        <em>使えるかたちに。</em>
      </h1>
      <p class="stack-lead">
        WebとiOSのアプリ開発から、
        <br />
        AIでつくったアプリの診断・運用相談まで。
      </p>
      <div class="stack-actions">
        <a class="button" href="#works">
          つくっているものを見る <Arrow />
        </a>
        <a class="stack-secondary" href="/app-clinic">
          AIアプリ診療所について <Arrow />
        </a>
      </div>
    </div>
    <div class="stack-technologies">
      <h2 class="sr-only">得意な技術</h2>
      <ul class="stack-logos" aria-label="得意な技術">
        {technologies.map(({ name, file, slug }, i) => (
          <li
            class:list={["stack-tech", `stack-tech-${slug}`]}
            style={`--float-duration: ${7 + (i % 5) * 0.8}s; --float-delay: ${-i * 0.9}s; --float-distance: ${7 + (i % 3) * 2}px;`}
          >
            <span class="stack-tech-mark">
              <img
                src={`/brand/technologies/${file}`}
                width="64"
                height="64"
                alt={name}
              />
            </span>
          </li>
        ))}
      </ul>
      <button
        class="stack-motion-toggle"
        type="button"
        aria-label="ロゴの動きを一時停止"
        aria-pressed="false"
        hidden
      >
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
          <path
            class="stack-pause"
            d="M5 3v10M11 3v10"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          />
          <path class="stack-play" d="m5 3 8 5-8 5z" fill="currentColor" />
        </svg>
      </button>
    </div>
  </div>
  <div class="studio-band">
    <span>WEB APPS</span>
    <span aria-hidden="true">/</span>
    <span>iOS APPS</span>
    <span aria-hidden="true">/</span>
    <span>APP SUPPORT</span>
  </div>
</section>

<style>
  .stack-hero {
    overflow: hidden;
    background: white;
    border-bottom: 2px solid var(--ink);
  }
  .stack-stage {
    position: relative;
    isolation: isolate;
    max-width: 1600px;
    min-height: 690px;
    margin-inline: auto;
    padding: 45px 24px 194px;
  }
  .stack-copy {
    position: relative;
    z-index: 1;
    width: min(100%, 640px);
    margin-inline: auto;
    text-align: center;
  }
  .stack-eyebrow {
    margin: 0 0 16px;
    color: var(--muted);
    font: 600 11px/1.5 var(--display);
    letter-spacing: 0.13em;
  }
  .stack-wordmark {
    display: block;
    width: 460px;
    max-width: 100%;
    height: auto;
    margin: 0 auto 20px;
  }
  .stack-copy h1 {
    font-size: 30px;
    font-weight: 900;
    line-height: 1.55;
    letter-spacing: -0.05em;
    margin: 0 0 18px;
  }
  .stack-copy h1 em {
    font-style: normal;
    text-decoration: underline;
    text-decoration-color: var(--accent-surface);
    text-decoration-thickness: 0.28em;
    text-underline-offset: -0.06em;
    text-decoration-skip-ink: none;
  }
  .stack-lead {
    font-size: 15px;
    line-height: 1.9;
    color: var(--muted);
    margin: 0 0 24px;
  }
  .stack-actions {
    display: flex;
    justify-content: center;
    align-items: stretch;
    gap: 20px;
  }
  .stack-actions .button,
  .stack-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-height: 54px;
    padding: 13px 18px;
    font-size: 14px;
    font-weight: 700;
  }
  .stack-secondary {
    color: var(--ink);
    background: white;
    border: 2px solid var(--ink);
    border-radius: 4px;
    transition: background 0.2s;
  }
  .stack-secondary:hover {
    background: var(--accent-surface);
  }
  .stack-secondary :global(svg) {
    width: 20px;
    height: 20px;
  }
  .stack-logos {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .stack-tech {
    position: absolute;
    display: grid;
    justify-items: center;
    width: 112px;
    margin: 0;
    transform: translateX(-50%);
  }
  .stack-tech-mark {
    display: grid;
    place-items: center;
    width: 82px;
    height: 82px;
    transform: rotate(var(--tilt, -7deg));
  }
  .stack-tech-mark img {
    display: block;
    width: 68px;
    height: 68px;
    object-fit: contain;
  }
  .stack-tech-react {
    left: 22%;
    top: 65px;
    --tilt: -10deg;
  }
  .stack-tech-typescript {
    left: 78%;
    top: 65px;
    --tilt: 9deg;
  }
  .stack-tech-nextjs {
    left: 9%;
    top: 245px;
    --tilt: -6deg;
  }
  .stack-tech-vercel {
    left: 91%;
    top: 245px;
    --tilt: 8deg;
  }
  .stack-tech-wordpress {
    left: 18%;
    top: 420px;
    --tilt: 8deg;
  }
  .stack-tech-cloudflare {
    left: 82%;
    top: 420px;
    --tilt: -9deg;
  }
  .stack-tech-php {
    left: 36%;
    bottom: 48px;
    --tilt: -7deg;
  }
  .stack-tech-emdash {
    left: 64%;
    bottom: 48px;
    --tilt: 5deg;
  }
  .stack-tech-php img,
  .stack-tech-cloudflare img {
    width: 82px;
  }
  .stack-tech-wordpress img {
    width: 98px;
    height: 98px;
  }
  @media (min-width: 1001px) and (max-height: 800px) {
    .stack-stage {
      min-height: 600px;
      padding-top: 28px;
      padding-bottom: 164px;
    }
    .stack-wordmark {
      width: 340px;
      margin-bottom: 12px;
    }
    .stack-copy h1 {
      font-size: 25px;
      line-height: 1.45;
      margin-bottom: 12px;
    }
    .stack-eyebrow {
      font-size: 10px;
      margin-bottom: 12px;
    }
    .stack-lead {
      font-size: 14px;
      line-height: 1.8;
      margin-bottom: 16px;
    }
    .stack-tech-react,
    .stack-tech-typescript {
      top: 40px;
    }
    .stack-tech-nextjs,
    .stack-tech-vercel {
      top: 200px;
    }
    .stack-tech-wordpress,
    .stack-tech-cloudflare {
      top: 350px;
    }
  }
  @media (max-width: 1100px) and (min-width: 1001px) {
    .stack-tech-react {
      left: 16%;
    }
    .stack-tech-typescript {
      left: 84%;
    }
    .stack-tech-wordpress {
      left: 11%;
    }
    .stack-tech-cloudflare {
      left: 89%;
    }
  }
  @media (max-width: 1000px) {
    .stack-stage {
      padding: 38px 24px 30px;
      min-height: 0;
    }
    .stack-wordmark {
      width: 420px;
    }
    .stack-technologies {
      max-width: 600px;
      margin: 42px auto 44px;
    }

    .stack-logos {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 28px 20px;
    }
    .stack-tech {
      position: static;
      width: auto;
      transform: none;
      gap: 10px;
    }
    .stack-tech-mark {
      width: 65px;
      height: 65px;
    }
    .stack-tech-mark img {
      width: 52px;
      height: 52px;
    }
    .stack-tech-wordpress img {
      width: 76px;
      height: 76px;
    }
    .stack-tech-php img,
    .stack-tech-cloudflare img {
      width: 60px;
    }
  }
  @media (max-width: 640px) {
    .stack-stage {
      padding: 26px 22px 30px;
    }
    .stack-eyebrow {
      font-size: 9px;
      letter-spacing: 0.1em;
      margin-bottom: 12px;
    }
    .stack-wordmark {
      width: 310px;
      margin-bottom: 18px;
    }
    .stack-copy h1 {
      font-size: clamp(25px, 7vw, 30px);
      margin-bottom: 14px;
    }
    .stack-lead {
      font-size: 13px;
      margin-bottom: 22px;
    }
    .stack-actions {
      flex-direction: column;
      gap: 14px;
    }
    .stack-actions .button,
    .stack-secondary {
      min-height: 48px;
      padding: 10px 14px;
    }
    .stack-technologies {
      margin-top: 32px;
    }
    .stack-logos {
      gap: 24px 10px;
    }
    .stack-tech-mark {
      width: 54px;
      height: 54px;
    }
    .stack-tech-mark img {
      width: 40px;
      height: 40px;
    }
    .stack-tech-php img,
    .stack-tech-cloudflare img {
      width: 48px;
    }
    .stack-tech-wordpress img {
      width: 60px;
      height: 60px;
    }
  }
  .stack-hero[data-motion-ready] .stack-tech-mark {
    animation: logo-float var(--float-duration) ease-in-out var(--float-delay)
      infinite;
  }
  .stack-hero[data-motion-paused="true"] .stack-tech-mark {
    animation-play-state: paused;
  }
  @keyframes logo-float {
    0%,
    100% {
      transform: translateY(0) rotate(var(--tilt, -7deg));
    }
    50% {
      transform: translateY(calc(-1 * var(--float-distance)))
        rotate(var(--tilt, -7deg));
    }
  }
  .stack-motion-toggle {
    position: absolute;
    right: 22px;
    bottom: 8px;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .stack-motion-toggle:hover {
    color: var(--primary);
  }
  .stack-motion-toggle[hidden],
  .stack-play {
    display: none;
  }
  .stack-motion-toggle[aria-pressed="true"] .stack-pause {
    display: none;
  }
  .stack-motion-toggle[aria-pressed="true"] .stack-play {
    display: block;
  }
  @media (prefers-reduced-motion: reduce) {
    .stack-hero[data-motion-ready] .stack-tech-mark {
      animation: none;
    }
    .stack-motion-toggle {
      display: none;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>(".stack-hero");
  const toggle = hero?.querySelector<HTMLButtonElement>(".stack-motion-toggle");
  if (hero && toggle) {
    hero.dataset.motionReady = "true";
    toggle.hidden = false;
    toggle.addEventListener("click", () => {
      const paused = toggle.getAttribute("aria-pressed") !== "true";
      hero.dataset.motionPaused = String(paused);
      toggle.setAttribute("aria-pressed", String(paused));
      toggle.setAttribute(
        "aria-label",
        paused ? "ロゴの動きを再生" : "ロゴの動きを一時停止",
      );
    });
  }
</script>
