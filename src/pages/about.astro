---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
const about = {
  title: '業務の理解から、\n開発・公開後の運用まで。',
  text: '企業向け業務システムの導入プロジェクトに、コンサルタントとして10年以上従事。React / Next.jsを中心としたWebアプリ開発に5年以上携わっています。開発リードとして複数の企業向けFintech系Webアプリをリリースし、現在も運用・保守を担当しています。',
  items: [
    {
      title: 'ご自身で、育て続けるために。',
      text: 'その経験をもとに、AIで作ったアプリの改善点と優先順位を整理し、ご自身で育て続けるための判断と実務を支援します。',
    },
  ],
};
const legal = [
  ['役務提供事業者', ''],
  ['所在地', ''],
  ['電話番号・受付時間', ''],
  ['メールアドレス', 'info@therethere.studio'],
  [
    'サービス料金',
    '診断は税別30,000円（税込33,000円）の固定料金。通常、個人で作成したWebアプリの診断はこの金額を超えません。規模が大きく複雑な場合に限り、作業着手前に別途見積もりし、ご了承いただいてから開始します。修正・公開作業は別途見積もり。',
  ],
  ['料金以外の負担', ''],
  [
    '支払方法・時期',
    '診断後の請求書払い・後払い。銀行振込、または請求書ごとのStripe決済リンクからカード決済。支払日はご依頼前に合意します。',
  ],
  ['提供時期', '対象を確認し、契約前に個別に合意します。'],
  ['キャンセル・返金', ''],
  ['継続保守の契約条件', '提供準備中。'],
  ['その他の適用条件', ''],
];
---

<Layout title="運営者情報と特定商取引法に基づく表記｜There There Studio" noindex>
  <div class="page-wrap">
    <p class="breadcrumb">
      <a href="/">ホーム</a> / 運営者情報
    </p>
    <span class="mono">THERE THERE STUDIO</span>
    <h1 class="page-title">運営について。</h1><p class="page-lead">There There Studioは、茨城県つくば市のアプリ開発スタジオです。Web・iOSアプリの企画・開発と、AIアプリ診療所を運営しています。</p>
    <div class="profile">
      <img src="/images/operator.png" width="1254" height="1254" alt="There There Studioの運営者" />
      <div>
        <h2>{about.title}</h2>
        <p>{about.text}</p>
        {about.items.map((item) => (
          <>
            <h2>{item.title}</h2>
            <p>{item.text}</p>
          </>
        ))}
      </div>
    </div>
    <section id="legal">
      <span class="mono">BUSINESS INFORMATION</span>
      <h2>特定商取引法に基づく表記</h2>
      <p class="draft-note">
        事業者情報と取引条件は準備中です。本ページは仮版です。未確定の項目は「準備中」として記載しています。正式なご依頼をお受けする前に確定し、ご案内します。
      </p>
      <table class="legal-table">
        <tbody>
          {legal.map(([label, value]) => (
            <tr>
              <th scope="row">{label}</th>
              <td>{value || '準備中'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
    <a class="text-link" href="/#contact">
      お問い合わせ →
    </a>
  </div>
</Layout>
