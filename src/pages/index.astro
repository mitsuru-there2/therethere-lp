---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import Contact from "../components/Contact.astro";
import ReportPreview from "../components/diagnosis/ReportPreview.astro";
import Arrow from "../components/Arrow.astro";
import StudioHero from "../components/StudioHero.astro";
import { ja } from "../data/ja";
import { renderParts } from "../lib/render";
---

<Layout
  landing
  title="There There Studio｜アプリ開発と、AIアプリの診断・運用相談"
  description="つくばを拠点に、Web・iOSアプリを企画・開発するスタジオ。怪獣スタンプ、レコーダー維新、チェックリスト維新と、AIでつくったアプリの診断・運用を支えるAIアプリ診療所を紹介します。"
>
  <StudioHero />
  <section id="works" class="section wrap works-section">
    <div class="works-heading">
      <h2>
        Works<span class="accent">.</span>
      </h2>
      <p>つくっているもの、支えていること。</p>
    </div>
    <article class="featured-clinic">
      <div>
        <p class="dc-kicker">FEATURED / 診断・運用支援</p>
        <h3>
          <img src="/brand/symbol-blue-v1.png" width="60" height="60" alt="" />
          AIアプリ診療所
        </h3>
        <h4>「動いた」の、その先を一緒に。</h4>
        <p class="featured-description">
          AIでつくったWebアプリの、権限・データ・公開設定を診断。改善の優先順位と、自分で直すための手順をお伝えします。
        </p>
        <p class="featured-price">
          診断・アドバイス <strong>33,000円</strong>（税込）
        </p>
        <a class="button" href="/app-clinic" data-event="cta_click">
          診断について詳しく見る <Arrow />
        </a>
      </div>
      <ReportPreview overview />
    </article>
    <div class="works-grid">
      <article class="work-item reveal">
        <a
          class="work-media kaiju-media"
          href="https://kaijustamps.com/ja"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="怪獣スタンプのサイトを見る（新しいタブ）"
        >
          <img
            class="kaiju-wordmark"
            src="/images/kaiju-wordmark.webp"
            width="768"
            height="193"
            alt="怪獣スタンプ"
            loading="lazy"
          />
          <img
            class="kaiju-wallet"
            src="/images/kaiju-wallet.webp"
            width="560"
            height="1218"
            alt="Apple Walletのデジタルスタンプカード"
            loading="lazy"
          />
          <span class="work-open" aria-hidden="true">
            ↗
          </span>
        </a>
        <div class="work-caption">
          <span class="mono">01 / Webアプリ</span>
          <h3>
            <a
              href="https://kaijustamps.com/ja"
              target="_blank"
              rel="noopener noreferrer"
            >
              怪獣スタンプ ↗
            </a>
          </h3>
          <p set:html={renderParts(ja.home.works[0].description)} />
        </div>
      </article>

      {(["recorder", "checklist"] as const).map((key, i) => {
        const product = ja[key];
        return (
          <article class="work-item reveal">
            <a
              class:list={["work-media", "ios-media", key]}
              href={`/${key}`}
              aria-label={`${product.name}の紹介を見る`}
            >
              <img
                class="work-splash"
                src={product.poster.src}
                width={product.poster.width}
                height={product.poster.height}
                alt={product.posterAlt}
                loading="lazy"
              />
              <img
                class="work-screen"
                src={product.frames[1].src}
                width={product.frames[1].width}
                height={product.frames[1].height}
                alt={product.frames[1].alt}
                loading="lazy"
              />
              <span class="work-open" aria-hidden="true">
                ↗
              </span>
            </a>
            <div class="work-caption">
              <span class="mono">0{i + 2} / iOSアプリ</span>
              <h3>
                <a href={`/${key}`}>{product.name}</a>
              </h3>
              <p set:html={renderParts(ja.home.works[i + 1].description)} />
              <a
                class="text-link work-store"
                href={product.storeHref}
                target="_blank"
                rel="noopener noreferrer"
              >
                App Storeで入手 ↗
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </section>
  <section class="studio-about" id="about">
    <div class="section wrap studio-about-grid reveal">
      <div>
        <span class="section-label">スタジオについて</span>
        <h2>
          自分でつくる。
          <br />
          だから、寄り添える。
        </h2>
      </div>
      <div>
        <p>
          お店を営むこと。音楽を楽しむこと。
          <br />
          日々の経験から生まれた気づきを、使う人に寄り添うアプリに変えています。
        </p>
        <p>
          企画・開発から、公開後の運用まで。自分でもつくり続けるスタジオだからこそ、AIでアプリをつくる人の「その先」も支えます。
        </p>
        <a class="text-link" href="/about">
          運営について <Arrow />
        </a>
      </div>
    </div>
  </section>
  <section class="blog-strip wrap">
    <div>
      <span class="mono">スタジオのブログ</span>
      <h2>つくること、育てること。</h2>
      <p>アプリ開発のこと。公開後の運用のこと。</p>
    </div>
    <a class="text-link" href="/blog">
      記事を読む <Arrow />
    </a>
  </section>
  <Contact />
</Layout>
