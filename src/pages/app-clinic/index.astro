---
import Layout from "../../layouts/Layout.astro";
import Arrow from "../../components/Arrow.astro";
import ContactForm from "../../components/ContactForm.astro";
import ReportPreview from "../../components/diagnosis/ReportPreview.astro";
import Operator from "../../components/diagnosis/Operator.astro";
export const prerender = false;
const checks = [
  {
    title: "権限とデータ",
    text: "ログインと利用者ごとのアクセス権限。必要な情報が、見せてよい相手にだけ届くかを確認します。",
  },
  {
    title: "秘密情報と公開設定",
    text: "APIキーなどの秘密情報、管理画面、公開設定。アプリの内側と外側の境界を確認します。",
  },
  {
    title: "異変への備え",
    text: "エラーの記録と通知、バックアップ、復旧手順。公開後に困ったときの備えを確認します。",
  },
];
const steps = [
  {
    title: "状況を伝える",
    text: "作ったアプリと、気になることを共有。技術の名前が分からなくても大丈夫です。",
  },
  {
    title: "範囲と料金を確認",
    text: "対応可否・成果物・料金・納期をご案内。納得してから、ご依頼いただけます。",
  },
  {
    title: "診断と説明を受ける",
    text: "根拠と優先順位、直し方、確認方法をレポートにまとめてお伝えします。",
  },
  {
    title: "自分のペースで改善",
    text: "自分で直す、必要な作業を相談する。次の進め方は、ご自身で選べます。",
  },
];
const faq = {
  title: "相談の前に、\n知っておきたいこと。",
  text: "",
  items: [
    {
      title: "診断料金が33,000円（税込）を超えることはありますか？",
      text: "通常、個人で作成したWebアプリの診断は税別30,000円（税込33,000円）を超えることはありません。規模が大きく複雑な場合に限り、作業着手前に別途お見積もりし、ご了承いただいてから開始します。修正・公開作業を追加で依頼する場合は、診断とは別にお見積もりします。",
    },
    {
      title: "納期や、質問できる回数は決まっていますか？",
      text: "対象のアプリと確認範囲を伺ったうえで、ご依頼前に納期をご案内します。結果の説明方法、質問・再確認の回数も事前に合意します。連絡は非同期中心、打合せは予約制です。",
    },
    {
      title: "支払いはいつですか？",
      text: "診断後の請求書払い・後払いです。銀行振込、または請求書ごとにご案内するStripeの決済リンクからカードでお支払いいただけます。支払日はご依頼前に合意します。",
    },
    {
      title: "事例掲載に協力しなくても依頼できますか？",
      text: "はい。通常料金で、事例を公開しない診断も選べます。掲載にご協力いただく場合は、診断後のアンケート回答と事例掲載の許可で診断料金から税別3,000円を割り引きます。公開する範囲と掲載原稿は、公開前に確認・承認いただきます。高評価や好意的な回答は条件ではありません。",
    },
    {
      title: "自分で修正してもよいですか？",
      text: "はい。自分で改善できるように手順と確認方法をお伝えします。修正の追加依頼は必須ではありません。",
    },
    {
      title: "公開済みのアプリでも相談できますか？",
      text: "はい。公開前・運用中・変更後の状況に合わせ、確認する範囲をご相談します。",
    },
    {
      title: "使っている技術がよく分からなくても大丈夫ですか？",
      text: "分かる範囲で、使った作成ツールや公開方法をお知らせください。対応できる構成か確認します。",
    },
    {
      title: "診断を受ければ安全だと保証されますか？",
      text: "合意した範囲と確認時点での問題、改善案、未確認事項をお伝えするサービスです。網羅的な脆弱性診断や安全性の認証は含みません。",
    },
    {
      title: "すぐに復旧してほしい場合も依頼できますか？",
      text: "予約制・非同期中心のため、24時間の有人対応や即時復旧には対応していません。",
    },
    {
      title: "コードやデータはどう渡しますか？",
      text: "最初のフォームでは概要だけを伺います。コードの共有方法、必要な権限、AIツールの利用範囲は、診断前に確認します。",
    },
  ],
};
---

<Layout
  clinic
  landing
  title="AIアプリ診療所｜AIでつくったWebアプリの診断・運用相談"
  description="AIで作ったWebアプリの権限・データ・公開設定を確認。根拠付きの診断レポートと、自分で直す手順・確認方法をお渡しします。診断・アドバイス33,000円（税込）。"
>
  <section class="dc-hero">
    <div class="dc-wrap">
      <p class="dc-breadcrumb">
        <a href="/">ホーム</a>
        <span>/</span>AIアプリ診断
      </p>
    </div>
    <div class="dc-wrap dc-hero-grid">
      <div class="dc-hero-copy">
        <p class="dc-eyebrow">AIでつくったWebアプリの診断</p>
        <h1>
          何を直すか。
          <br />
          どう直すか。
          <br />
          <em>一緒に、明確に。</em>
        </h1>
        <p class="dc-lead">
          権限・データ・公開設定を確認し、
          <br class="desktop-break" />
          改善の優先順位と、あなた自身で
          <br class="desktop-break" />
          直すための手順をお伝えします。
        </p>
        <div class="dc-actions">
          <a class="button" href="#contact" data-event="cta_click">
            診断について相談する <Arrow />
          </a>
          <a class="text-link" href="#report">
            レポートの例を見る <Arrow />
          </a>
        </div>
        <p class="dc-hero-price">
          <strong>33,000円</strong>（税込）
          <small>送信だけでは契約・課金は発生しません。</small>
        </p>
      </div>
      <ReportPreview overview />
    </div>
    <div class="dc-stage-band">
      <span>公開前の確認</span>
      <span>運用中の見直し</span>
      <span>機能変更後のチェック</span>
    </div>
  </section>
  <section class="dc-section" id="diagnosis">
    <div class="dc-wrap">
      <p class="dc-kicker">01 / 診断で確認すること</p>
      <h2>
        公開の前も、
        <br class="mobile-break" />
        その後も。
      </h2>
      <p class="dc-section-lead">
        「このデータ、誰から見える？」「このまま公開して、大丈夫？」
        <br />
        気になるところから、確認する範囲を一緒に決めます。
      </p>
      <div class="dc-columns">
        {checks.map((item, i) => (
          <div>
            <span class="dc-number">0{i + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
      <p class="dc-scope-note">
        <strong>対象は、AIでつくったWebアプリです。</strong>{" "}
        使用ツール・構成・規模を伺い、対応可否を事前に確認します。網羅的な脆弱性診断や、安全性の認証ではありません。
      </p>
    </div>
  </section>
  <section class="dc-section dc-tint" id="report">
    <div class="dc-wrap">
      <p class="dc-kicker">02 / 診断レポートの例</p>
      <h2>
        指摘だけで、
        <br class="mobile-break" />
        終わらせません。
      </h2>
      <div class="dc-report-layout">
        <div class="dc-report-intro">
          <h3>
            自分で直すための、
            <br />
            道しるべ。
          </h3>
          <p>
            問題の内容だけでなく、なぜ問題なのかという根拠、影響、具体的な改善手順、直した後の確認方法まで。
          </p>
          <p>自分で判断して進められるように、分かりやすくまとめます。</p>
          <p class="dc-report-note">
            このレポートは説明用の架空例です。実際の診断内容は、対象と合意した範囲によって異なります。
          </p>
        </div>
        <article
          class="dc-report-detail"
          aria-labelledby="report-example-title"
        >
          <div class="dc-preview-bar">
            <span>診断レポート / 抜粋</span>
            <span class="dc-sample-tag">サンプル</span>
          </div>
          <div class="dc-report-title">
            <span class="dc-status-high">優先度 高</span>
            <h3 id="report-example-title">
              他の利用者の予約が
              <br class="mobile-break" />
              見える可能性
            </h3>
          </div>
          <dl>
            <div>
              <dt>確認したこと</dt>
              <dd>
                予約一覧の取得処理で、ログイン中の利用者に応じたアクセス制限が不足していました。
              </dd>
            </div>
            <div>
              <dt>影響</dt>
              <dd>
                別の利用者の予約情報が、閲覧できてしまう可能性があります。
              </dd>
            </div>
            <div>
              <dt>改善の手順</dt>
              <dd>
                <ol>
                  <li>
                    サーバー側で、ログイン中の利用者が閲覧できる予約だけを返す。
                  </li>
                  <li>
                    予約の詳細・編集・削除の処理にも、同じ権限確認を適用する。
                  </li>
                </ol>
              </dd>
            </div>
            <div>
              <dt>修正後の確認</dt>
              <dd>
                別々のテストアカウントで、自分の予約だけが見えることを確認。別の利用者の予約IDを指定しても、取得・変更できないことを確かめます。
              </dd>
            </div>
            <div>
              <dt>未確認のこと</dt>
              <dd>
                今回の合意範囲外の管理者機能と、外部連携の権限設定。追加で確認すべき箇所として記録します。
              </dd>
            </div>
          </dl>
        </article>
      </div>
      <p class="dc-report-footer">
        診断レポート・改善の手順・修正後の確認方法・未確認事項を、説明とあわせてお渡しします。
      </p>
    </div>
  </section>
  <section class="dc-section" id="operator">
    <div class="dc-wrap">
      <Operator />
    </div>
  </section>
  <section class="dc-section dc-tint" id="pricing">
    <div class="dc-wrap">
      <p class="dc-kicker">03 / 料金</p>
      <h2>
        まずは診断。
        <br class="mobile-break" />
        その先は、必要な分だけ。
      </h2>
      <p class="dc-section-lead">
        診断と説明だけでも依頼できます。修正の追加依頼は必須ではありません。
      </p>
      <div class="dc-pricing">
        <div class="dc-pricing-main">
          <div class="dc-pricing-amount">
            <h3>診断・アドバイス</h3>
            <p>
              <strong>33,000</strong>
              <span>円（税込）</span>
            </p>
            <small>税別30,000円 / 1アプリ・合意した範囲</small>
          </div>
          <ul class="dc-pricing-includes">
            <li>根拠付きの診断レポート</li>
            <li>自分で直す手順・確認方法</li>
            <li>診断結果の説明</li>
          </ul>
          <a class="button" href="#contact" data-event="cta_click">
            診断を相談する <Arrow />
          </a>
        </div>
        <div class="dc-pricing-terms">
          <p>
            <strong>
              通常、個人で作成したWebアプリの診断は、この金額を超えません。
            </strong>{" "}
            規模が大きく複雑な場合に限り、着手前に別途お見積もりし、ご了承いただいてから開始します。
          </p>
          <dl>
            <div>
              <dt>範囲・納期</dt>
              <dd>対象を確認し、ご依頼前に合意します。</dd>
            </div>
            <div>
              <dt>説明・質問</dt>
              <dd>説明方法、質問や再確認の回数は事前に合意します。</dd>
            </div>
            <div>
              <dt>お支払い</dt>
              <dd>診断後の請求書払い。銀行振込・カード決済に対応。</dd>
            </div>
          </dl>
        </div>
      </div>
      <div class="dc-pricing-extras">
        <div>
          <h3>修正・公開作業は、必要な分だけ。</h3>
          <p>
            ご自身での修正と組み合わせて相談できます。対応範囲を決めて、別途お見積もりします。継続保守は提供準備中です。
          </p>
        </div>
        <details>
          <summary>事例掲載へのご協力による割引について</summary>
          <p>
            診断後のアンケート回答と事例掲載の許可で、税別3,000円引き。通常料金の場合は29,700円（税込）です。公開範囲と掲載原稿は公開前に確認・承認いただきます。高評価は条件ではありません。通常料金で非公開の診断も選べます。
          </p>
        </details>
      </div>
    </div>
  </section>
  <section class="dc-section" id="flow">
    <div class="dc-wrap">
      <p class="dc-kicker">04 / ご相談から診断まで</p>
      <h2>
        つくる主役は、
        <br class="mobile-break" />
        これからも、あなたです。
      </h2>
      <ol class="dc-flow">
        {steps.map((item, i) => (
          <li>
            <span>0{i + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ol>
      <p class="dc-small-note">
        連絡は非同期中心、打合せは予約制です。24時間の有人対応・即時復旧は行っていません。
      </p>
    </div>
  </section>
  <section class="dc-section dc-tint" id="faq">
    <div class="dc-wrap dc-faq-grid">
      <div>
        <p class="dc-kicker">05 / よくある質問</p>
        <h2>
          相談の前に、
          <br />
          知っておきたいこと。
        </h2>
      </div>
      <div class="dc-faq">
        {faq.items.map((item) => (
          <details>
            <summary>
              <span aria-hidden="true">Q.</span>
              {item.title}
            </summary>
            <p>{item.text}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  <section class="dc-section dc-contact" id="contact">
    <div class="dc-wrap dc-contact-grid">
      <div>
        <p class="dc-kicker">LET’S TALK</p>
        <h2>
          今のアプリのこと、
          <br />
          聞かせてください。
        </h2>
        <p>
          何を見てもらうか決まっていなくても大丈夫。
          <br />
          作ったものと、気になっていることから
          <br class="desktop-break" />
          ご相談ください。
        </p>
        <div class="dc-contact-assurance">
          <p>
            <strong>診断・アドバイス 33,000円（税込）</strong>
          </p>
          <p>
            送信だけでは契約・課金は発生しません。
            <br />
            対象・費用・納期に納得してから依頼できます。
          </p>
        </div>
      </div>
      <ContactForm />
    </div>
  </section>
  <section class="dc-journal dc-wrap">
    <div>
      <p class="dc-kicker">TECH JOURNAL</p>
      <h2>自分でつくる人の、運用ノート。</h2>
      <p>アプリ開発と、公開後の運用のヒント。</p>
    </div>
    <a class="text-link" href="/app-clinic/blog">
      記事を読む <Arrow />
    </a>
  </section>
</Layout>
